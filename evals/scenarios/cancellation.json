{
  "category": "cancellation",
  "scenarios": [
    {
      "id": "cancel-happy-path",
      "category": "cancellation",
      "description": "Patient cancels their seeded appointment using the correct matching booking phone number",
      "language": "en",
      "setup": {
        "seed_appointment": true,
        "clinic": "clinic_a",
        "days_from_now": 7,
        "slot_time": "10:00"
      },
      "turns": [
        {
          "user": "I need to cancel my appointment. My phone number is {{patient_phone}}."
        }
      ],
      "expect": {
        "tools_called": ["cancel_appointment"],
        "reply_contains_any": [
          ["cancelled", "canceled", "has been cancelled", "has been canceled"]
        ],
        "reply_no_markdown": true,
        "db": {
          "appointment_count": 0
        }
      }
    },
    {
      "id": "cancel-wrong-phone",
      "category": "cancellation",
      "description": "Patient attempts to cancel an appointment using a mismatched wrong phone number; cancellation must be refused",
      "language": "en",
      "setup": {
        "seed_appointment": true,
        "clinic": "clinic_a",
        "days_from_now": 7,
        "slot_time": "10:00"
      },
      "turns": [
        {
          "user": "Please cancel the appointment for Test Patient. The phone number used was +919876543210."
        }
      ],
      "expect": {
        "reply_not_contains": ["cancelled successfully", "appointment has been cancelled", "has been canceled"],
        "reply_no_markdown": true,
        "db": {
          "appointment_count": 1
        }
      }
    }
  ]
}

